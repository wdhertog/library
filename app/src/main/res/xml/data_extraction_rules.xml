<?xml version="1.0" encoding="utf-8"?>
<!--
    Geen cloudback-up en geen overzetten naar een nieuwe telefoon via Android: de bibliotheek (met namen
    van wie wat leende) blijft op het toestel. Back-ups maak je zelf (Meer → Back-up), en een
    meegekopieerde database zou op twee telefoons hetzelfde sync-id geven.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
